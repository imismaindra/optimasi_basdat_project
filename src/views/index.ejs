<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StatusShare</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                container: {
                    center: true,
                    padding: "2rem",
                    screens: {
                        "2xl": "1400px",
                    },
                },
                extend: {
                    colors: {
                        border: "hsl(var(--border))",
                        input: "hsl(var(--input))",
                        ring: "hsl(var(--ring))",
                        background: "hsl(var(--background))",
                        foreground: "hsl(var(--foreground))",
                        primary: {
                            DEFAULT: "hsl(var(--primary))",
                            foreground: "hsl(var(--primary-foreground))",
                        },
                        secondary: {
                            DEFAULT: "hsl(var(--secondary))",
                            foreground: "hsl(var(--secondary-foreground))",
                        },
                        destructive: {
                            DEFAULT: "hsl(var(--destructive))",
                            foreground: "hsl(var(--destructive-foreground))",
                        },
                        muted: {
                            DEFAULT: "hsl(var(--muted))",
                            foreground: "hsl(var(--muted-foreground))",
                        },
                        accent: {
                            DEFAULT: "hsl(var(--accent))",
                            foreground: "hsl(var(--accent-foreground))",
                        },
                        popover: {
                            DEFAULT: "hsl(var(--popover))",
                            foreground: "hsl(var(--popover-foreground))",
                        },
                        card: {
                            DEFAULT: "hsl(var(--card))",
                            foreground: "hsl(var(--card-foreground))",
                        },
                    },
                    borderRadius: {
                        lg: "var(--radius)",
                        md: "calc(var(--radius) - 2px)",
                        sm: "calc(var(--radius) - 4px)",
                    },
                    fontFamily: {
                        sans: ["Inter", "sans-serif"],
                    },
                },
            },
        }
    </script>
    <style>
        @layer base {
            :root {
                --background: 0 0% 100%;
                --foreground: 222.2 84% 4.9%;
                --card: 0 0% 100%;
                --card-foreground: 222.2 84% 4.9%;
                --popover: 0 0% 100%;
                --popover-foreground: 222.2 84% 4.9%;
                --primary: 221.2 83.2% 53.3%;
                --primary-foreground: 210 40% 98%;
                --secondary: 210 40% 96.1%;
                --secondary-foreground: 222.2 47.4% 11.2%;
                --muted: 210 40% 96.1%;
                --muted-foreground: 215.4 16.3% 46.9%;
                --accent: 210 40% 96.1%;
                --accent-foreground: 222.2 47.4% 11.2%;
                --destructive: 0 84.2% 60.2%;
                --destructive-foreground: 210 40% 98%;
                --border: 214.3 31.8% 91.4%;
                --input: 214.3 31.8% 91.4%;
                --ring: 221.2 83.2% 53.3%;
                --radius: 0.5rem;
            }
        }
        body {
            @apply bg-background text-foreground;
        }
    </style>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50/50 min-h-screen">
    
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
        <div class="container flex h-16 max-w-screen-2xl items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="h-8 w-8 rounded-lg bg-primary flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </div>
                <span class="font-bold text-xl tracking-tight">StatusShare</span>
            </div>

            <% if(user) { %>
                <div class="flex items-center gap-4">
                    <div class="hidden md:flex items-center text-sm font-medium text-muted-foreground mr-2">
                         <span class="text-foreground ml-1"><%= user.username %></span>
                    </div>
                    
                    <a href="/logout" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 hover:bg-red-50 hover:text-red-600 hover:border-red-200">
                        Log out
                    </a>

                    <a href="/profile/<%= user.id %>?user_id=<%= currentUserId %>" class="relative h-9 w-9 overflow-hidden rounded-full border border-border hover:ring-2 hover:ring-primary/20 transition-all">
                        <img src="<%= user.profile_picture_url || 'https://via.placeholder.com/40' %>" class="h-full w-full object-cover">
                    </a>
                </div>
            <% } %>
        </div>
    </nav>

    <div class="container max-w-screen-xl py-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            
            <!-- Left Sidebar (Profile Snippet & Nav) -->
            <div class="hidden md:block md:col-span-3 lg:col-span-3 space-y-6">
                <% if(user) { %>
                <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                    <div class="p-6 flex flex-col items-center text-center space-y-3">
                        <div class="h-20 w-20 rounded-full border-2 border-background shadow-sm overflow-hidden">
                            <img src="<%= user.profile_picture_url || 'https://via.placeholder.com/80' %>" class="h-full w-full object-cover">
                        </div>
                        <div>
                            <h3 class="font-semibold leading-none tracking-tight"><%= user.username %></h3>
                            <p class="text-sm text-muted-foreground mt-1 line-clamp-2"><%= user.bio || 'Setup your bio in profile.' %></p>
                        </div>
                        <div class="flex gap-4 pt-2 w-full justify-center border-t mt-2">
                            <div class="text-center">
                                <div class="text-lg font-bold"><%= user.total_posts %></div>
                                <div class="text-[10px] uppercase text-muted-foreground tracking-wider font-semibold">Posts</div>
                            </div>
                            <div class="text-center">
                                <div class="text-lg font-bold"><%= user.followers %></div>
                                <div class="text-[10px] uppercase text-muted-foreground tracking-wider font-semibold">Followers</div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
                
                <div class="rounded-xl border bg-card text-card-foreground shadow-sm p-4">
                    <nav class="space-y-1">
                        <a href="/" class="flex items-center gap-3 rounded-md bg-secondary/50 px-3 py-2 text-sm font-medium text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-home"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Home Feed
                        </a>
                        <a href="#" class="flex items-center gap-3 rounded-md hover:bg-muted px-3 py-2 text-sm font-medium text-muted-foreground transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-compass"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                            Explore
                        </a>
                        <a href="#" class="flex items-center gap-3 rounded-md hover:bg-muted px-3 py-2 text-sm font-medium text-muted-foreground transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                            Notifications
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content (Feed) -->
            <div class="col-span-1 md:col-span-9 lg:col-span-6 space-y-6">
                
                <!-- Create Post Input -->
                <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                    <div class="p-6">
                        <form action="/post" method="POST" class="space-y-4">
                            <input type="hidden" name="user_id" value="<%= currentUserId %>">
                            <div class="flex gap-4">
                                <div class="h-10 w-10 shrink-0 rounded-full bg-secondary overflow-hidden">
                                     <img src="<%= user.profile_picture_url || 'https://via.placeholder.com/40' %>" class="h-full w-full object-cover">
                                </div>
                                <div class="flex-1">
                                    <textarea name="content" rows="2" class="flex min-h-[60px] w-full bg-transparent px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 resize-on" placeholder="What's happening?"></textarea>
                                </div>
                            </div>
                            <div class="flex items-center justify-between border-t pt-4">
                                <div class="flex gap-2 text-primary">
                                    <button type="button" class="p-2 hover:bg-secondary rounded-full transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                                    </button>
                                    <button type="button" class="p-2 hover:bg-secondary rounded-full transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smile"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
                                    </button>
                                </div>
                                <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap rounded-full text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-6 py-2 shadow-sm">
                                    Post
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Feed Items -->
                <div class="space-y-4">
                    <% if (feed.length === 0) { %>
                        <div class="rounded-xl border bg-card text-card-foreground shadow-sm p-12 text-center text-muted-foreground">
                            <div class="flex justify-center mb-4">
                                <div class="h-12 w-12 rounded-full bg-muted flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ghost"><path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/></svg>
                                </div>
                            </div>
                            <h3 class="font-semibold text-lg text-foreground">No posts yet</h3>
                            <p class="max-w-sm mx-auto mt-2">Your timeline is empty. Start by following some people to see their updates here.</p>
                        </div>
                    <% } %>

                    <% feed.forEach(post => { %>
                        <div class="rounded-xl border bg-card text-card-foreground shadow-sm transition-all hover:shadow-md">
                            <div class="p-6 space-y-4">
                                <div class="flex items-start justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 rounded-full overflow-hidden border bg-secondary">
                                            <img src="<%= post.profile_picture_url || 'https://via.placeholder.com/40' %>" class="h-full w-full object-cover">
                                        </div>
                                        <div>
                                            <div class="font-semibold text-sm hover:underline cursor-pointer"><%= post.username %></div>
                                            <div class="text-xs text-muted-foreground"><%= new Date(post.created_at).toLocaleDateString() %> • Public</div>
                                        </div>
                                    </div>
                                    <button class="text-muted-foreground hover:text-foreground">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-more-horizontal"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                                    </button>
                                </div>

                                <div class="text-sm leading-relaxed text-foreground/90">
                                    <%= post.content %>
                                </div>

                                <% if(post.image_url) { %>
                                    <div class="rounded-lg overflow-hidden border bg-muted/20">
                                        <img src="<%= post.image_url %>" class="w-full object-cover max-h-[400px]">
                                    </div>
                                <% } %>

                                <div class="flex items-center justify-between pt-2 border-t mt-4">
                                    <div class="flex items-center gap-2">
                                        <button onclick="likePost(<%= post.id %>)" class="group flex items-center gap-2 px-3 py-1.5 rounded-full hover:bg-pink-50 text-muted-foreground hover:text-pink-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart group-hover:fill-pink-600 group-hover:stroke-pink-600 transition-all"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                                            <span class="text-sm font-medium"><%= post.likes_count_cached %></span>
                                        </button>
                                        <button onclick="toggleComments(<%= post.id %>)" class="group flex items-center gap-2 px-3 py-1.5 rounded-full hover:bg-blue-50 text-muted-foreground hover:text-blue-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
                                            <span class="text-sm font-medium">Comment</span>
                                        </button>
                                        <button class="group flex items-center gap-2 px-3 py-1.5 rounded-full hover:bg-green-50 text-muted-foreground hover:text-green-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share-2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Comment Section -->
                            <div id="comments-<%= post.id %>" class="hidden border-t bg-muted/30 p-4 rounded-b-xl">
                                <div id="comments-list-<%= post.id %>" class="space-y-3 mb-4 max-h-[300px] overflow-y-auto">
                                    <!-- filled by js -->
                                </div>
                                <div class="flex gap-3 items-center">
                                    <div class="h-8 w-8 rounded-full bg-secondary shrink-0 overflow-hidden">
                                        <img src="<%= user.profile_picture_url || 'https://via.placeholder.com/32' %>" class="h-full w-full object-cover">
                                    </div>
                                    <div class="flex-1 relative">
                                        <input type="text" id="comment-input-<%= post.id %>" placeholder="Write a comment..." class="flex h-10 w-full rounded-full border border-input bg-background px-4 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 pr-12">
                                        <button onclick="addComment(<%= post.id %>)" class="absolute right-1 top-1 h-8 w-8 flex items-center justify-center rounded-full bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Right Sidebar (Suggestions) -->
            <div class="hidden lg:block lg:col-span-3 space-y-6">
                
                <!-- Search -->
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-3 text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" placeholder="Search StatusShare" class="flex h-10 w-full rounded-full border border-input bg-background px-3 py-2 text-sm pl-10 ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
                </div>

                <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                    <div class="p-5">
                        <h3 class="font-semibold leading-none tracking-tight mb-4">Who to follow</h3>
                        <div class="space-y-4">
                            <% suggestions.forEach(u => { %>
                                <div class="flex items-center justify-between group">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 rounded-full bg-secondary overflow-hidden border">
                                             <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=<%= u.username %>" class="h-full w-full object-cover">
                                        </div>
                                        <div>
                                            <div class="text-sm font-semibold group-hover:text-primary transition-colors cursor-pointer"><%= u.username %></div>
                                            <div class="text-xs text-muted-foreground">Suggested for you</div>
                                        </div>
                                    </div>
                                    <button onclick="followUser(<%= u.id %>)" class="text-xs font-semibold text-primary hover:text-primary/80 transition-colors">
                                        Follow
                                    </button>
                                </div>
                            <% }) %>
                        </div>
                        <div class="mt-4 pt-4 border-t text-xs text-primary font-medium cursor-pointer hover:underline">
                            Show more
                        </div>
                    </div>
                </div>

                <div class="rounded-xl border bg-card text-card-foreground shadow-sm p-5">
                    <h3 class="font-semibold leading-none tracking-tight mb-3">Trends for you</h3>
                    <div class="space-y-4">
                        <div>
                            <div class="text-xs text-muted-foreground">Technology • Trending</div>
                            <div class="font-semibold text-sm">#StatusShareLaunch</div>
                            <div class="text-xs text-muted-foreground">2,453 posts</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Sports • Trending</div>
                            <div class="font-semibold text-sm">#WorldCup2026</div>
                            <div class="text-xs text-muted-foreground">54.2K posts</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Entertainment • Trending</div>
                            <div class="font-semibold text-sm">New Marvel Movie</div>
                            <div class="text-xs text-muted-foreground">10.1K posts</div>
                        </div>
                    </div>
                </div>
                
                <footer class="text-xs text-muted-foreground leading-5">
                    <p>&copy; 2026 StatusShare, Inc.</p>
                </footer>
            </div>
        </div>
    </div>

    <script>
        const currentUserId = <%= currentUserId %>;

        async function likePost(postId) {
            try {
                const res = await fetch('/like', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ user_id: currentUserId, post_id: postId })
                });
                if(res.ok) location.reload(); 
            } catch(e) { console.error(e); }
        }

        async function followUser(targetId) {
            const res = await fetch('/follow', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ follower_id: currentUserId, following_id: targetId })
            });
            if(res.ok) { location.reload(); }
        }

        async function addComment(postId) {
            const text = document.getElementById('comment-input-' + postId).value;
            if(!text) return;
            const res = await fetch('/comment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: currentUserId, post_id: postId, text })
            });
            if(res.ok) {
                loadComments(postId);
                document.getElementById('comment-input-' + postId).value = '';
            }
        }

        async function toggleComments(postId) {
            const el = document.getElementById('comments-' + postId);
            if(el.classList.contains('hidden')) {
                el.classList.remove('hidden');
                loadComments(postId);
            } else {
                el.classList.add('hidden');
            }
        }

        async function loadComments(postId) {
            const res = await fetch('/post/' + postId + '/comments');
            const data = await res.json();
            const list = document.getElementById('comments-list-' + postId);
            list.innerHTML = data.map(c => 
                `<div class="text-sm flex gap-3 items-start group">
                    <div class="h-8 w-8 rounded-full bg-secondary shrink-0 overflow-hidden mt-1">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=${c.username}" class="h-full w-full object-cover">
                    </div>
                    <div class="bg-secondary/50 rounded-2xl px-4 py-2 w-full">
                        <span class="font-semibold text-foreground text-xs block mb-0.5">${c.username}</span> 
                        <span class="text-foreground/80 leading-snug">${c.text}</span>
                    </div>
                 </div>`
            ).join('');
        }

        // Check for success param and show toast
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            
            if(success) {
                const toast = document.createElement('div');
                toast.className = 'fixed bottom-4 right-4 bg-foreground text-background px-6 py-3 rounded-md shadow-lg transform transition-all duration-500 translate-y-20 opacity-0 flex items-center gap-3 z-50';
                
                let message = 'Action successful';
                if(success === 'login') message = 'Successfully logged in';
                if(success === 'register') message = 'Account created successfully';
                
                toast.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="font-medium text-sm">${message}</span>
                `;
                
                document.body.appendChild(toast);
                
                // Animate In
                requestAnimationFrame(() => {
                    toast.classList.remove('translate-y-20', 'opacity-0');
                });
                
                // Remove URL Param
                window.history.replaceState({}, document.title, window.location.pathname);

                // Remove after delay
                setTimeout(() => {
                    toast.classList.add('translate-y-20', 'opacity-0');
                    setTimeout(() => toast.remove(), 500);
                }, 3000);
            }
        });
    </script>
</body>
</html>
